rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: users/{uid}  (profile doc)
// Fields:
//   - role: 'patient' | 'caregiver' (required, immutable after create)
//   - email: string, <= 200 chars (required, immutable after create)
//   - displayName / photoURL: from the Google account (optional)
//   - emergencyContact: {name, phone} | null — a third party's PII, so profile
//     reads are NOT open to all authenticated users.
//   - linkedCaregiverEmails: string[] (patient only, max 5) — the caregivers the
//     PATIENT nominated. This is the sole source of caregiver authority.
//   - createdAt: timestamp (required, immutable, must equal request.time)
//
// LINKING MODEL: patient-initiated only. The patient adds a caregiver's email to
// their own doc; the caregiver is recognised by their verified `auth.token.email`.
// A caregiver can never grant themselves access. Profile reads are scoped to the
// owner and nominated caregivers, so no one can enumerate users or harvest
// emergencyContact PII.
//
// Collection: users/{userId}/events/{eventId}
// Fields:
//   - type: string, one of ['physical_tension','sensory_overload','craving_spike',
//           'elevated_stress','reset','checkin','live_conversation'] (required, immutable)
//   - mood: string|null, one of ['calm','anxious','irritable','low','overwhelmed'] or null (required)
//   - script: string, <= 2000 chars (optional)
//   - createdAt: timestamp (required, immutable, must equal request.time)
//
// Collection: users/{userId}/alerts/{alertId}
// Fields:
//   - script: string, <= 2000 chars (required)
//   - triggeredBy: string, one of ['physical_tension','sensory_overload','craving_spike',
//                  'elevated_stress','manual'] (required, immutable)
//   - createdAt: timestamp (required, immutable, must equal request.time)
//
// events/alerts/incidents/sessions are readable by the owning user, or a
// caregiver whose email that user nominated. All are append-only.
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------
    // Helper functions
    // ---------------------------------------------------------------
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function isValidOptionalString(field, maxLen) {
      return !(field in request.resource.data) ||
             (request.resource.data[field] is string &&
              request.resource.data[field].size() <= maxLen);
    }

    function isRecentServerTimestamp(field) {
      return request.resource.data[field] == request.time;
    }

    function isValidEvent() {
      let allowedTypes = ['physical_tension', 'sensory_overload', 'craving_spike',
                           'elevated_stress', 'reset', 'checkin', 'live_conversation'];
      let allowedMoods = ['calm', 'anxious', 'irritable', 'low', 'overwhelmed'];
      return hasOnlyAllowedFields(['type', 'mood', 'script', 'createdAt']) &&
             hasRequiredFields(['type', 'mood', 'createdAt']) &&
             request.resource.data.type is string &&
             request.resource.data.type in allowedTypes &&
             (request.resource.data.mood == null || request.resource.data.mood in allowedMoods) &&
             isValidOptionalString('script', 2000) &&
             isRecentServerTimestamp('createdAt');
    }

    function isValidIncident() {
      return hasOnlyAllowedFields(['stage', 'observation', 'frame', 'createdAt']) &&
             hasRequiredFields(['stage', 'observation', 'createdAt']) &&
             request.resource.data.stage in ['intervening', 'escalated'] &&
             request.resource.data.observation is string &&
             request.resource.data.observation.size() <= 500 &&
             // Evidence frame is a small base64 JPEG data URL; capped well under
             // the 1 MB document limit.
             isValidOptionalString('frame', 400000) &&
             isRecentServerTimestamp('createdAt');
    }

    function isValidAlert() {
      let allowedTriggers = ['physical_tension', 'sensory_overload', 'craving_spike',
                              'elevated_stress', 'manual', 'relapse_risk'];
      return hasOnlyAllowedFields(['script', 'triggeredBy', 'createdAt']) &&
             hasRequiredFields(['script', 'triggeredBy', 'createdAt']) &&
             request.resource.data.script is string &&
             request.resource.data.script.size() <= 2000 &&
             request.resource.data.triggeredBy is string &&
             request.resource.data.triggeredBy in allowedTriggers &&
             isRecentServerTimestamp('createdAt');
    }

    function isValidProfileCreate() {
      let d = request.resource.data;
      return hasOnlyAllowedFields(['role', 'email', 'displayName', 'photoURL',
                                   'linkedCaregiverEmails', 'emergencyContact',
                                   'createdAt']) &&
             hasRequiredFields(['role', 'email', 'createdAt']) &&
             d.role in ['patient', 'caregiver'] &&
             d.email is string && d.email.size() <= 200 &&
             isRecentServerTimestamp('createdAt') &&
             (!('emergencyContact' in d) || d.emergencyContact == null ||
               (d.emergencyContact is map &&
                d.emergencyContact.keys().hasOnly(['name', 'phone']) &&
                d.emergencyContact.keys().hasAll(['name', 'phone']) &&
                d.emergencyContact.name is string && d.emergencyContact.name.size() <= 100 &&
                d.emergencyContact.phone is string && d.emergencyContact.phone.size() <= 30)) &&
             (!('linkedCaregiverEmails' in d) ||
               (d.linkedCaregiverEmails is list && d.linkedCaregiverEmails.size() <= 5));
    }

    // Linking is PATIENT-INITIATED and keyed on the caregiver's verified auth
    // email. The patient nominates who may see their data; a caregiver can never
    // attach themselves to someone who didn't invite them.
    //
    // This replaces an earlier caregiver-self-link rule that only checked the
    // TARGET was a patient and never that the requester had been invited — which
    // let any authenticated account link itself to any patient and read their
    // relapse snapshots. Do not reintroduce a requester-asserted link.
    function isInvitedCaregiver(patientUid) {
      return isAuthenticated() &&
        request.auth.token.email != null &&
        exists(/databases/$(database)/documents/users/$(patientUid)) &&
        get(/databases/$(database)/documents/users/$(patientUid))
          .data.get('linkedCaregiverEmails', [])
          .hasAny([request.auth.token.email]);
    }

    // The patient editing their own nominated caregivers / emergency contact.
    function isValidOwnerProfileUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(['emergencyContact', 'linkedCaregiverEmails']) &&
        (!('linkedCaregiverEmails' in request.resource.data) ||
          (request.resource.data.linkedCaregiverEmails is list &&
           request.resource.data.linkedCaregiverEmails.size() <= 5)) &&
        (!('emergencyContact' in request.resource.data) ||
          request.resource.data.emergencyContact == null ||
          (request.resource.data.emergencyContact is map &&
           request.resource.data.emergencyContact.keys().hasOnly(['name', 'phone']) &&
           request.resource.data.emergencyContact.keys().hasAll(['name', 'phone']) &&
           request.resource.data.emergencyContact.name is string &&
           request.resource.data.emergencyContact.name.size() <= 100 &&
           request.resource.data.emergencyContact.phone is string &&
           request.resource.data.emergencyContact.phone.size() <= 30));
    }

    // ---------------------------------------------------------------
    // users/{uid} — profile doc
    // ---------------------------------------------------------------
    match /users/{uid} {
      // Owner, or a caregiver this user explicitly nominated by email.
      //
      // Evaluated per document, so a caregiver's
      // `where('linkedCaregiverEmails','array-contains', <their email>)` query
      // succeeds while an unconstrained listing of /users is denied — which is
      // what stops profile (and emergencyContact PII) enumeration.
      allow read: if isOwner(uid) ||
        (isAuthenticated() &&
         request.auth.token.email != null &&
         resource.data.get('linkedCaregiverEmails', []).hasAny([request.auth.token.email]));
      allow create: if isOwner(uid) && isValidProfileCreate();
      // Either a caregiver linking themselves, or the owner correcting their own
      // emergency contact from Settings. Nothing else about a profile is mutable.
      allow update: if isOwner(uid) && isValidOwnerProfileUpdate();
      allow delete: if false;

      // -------------------------------------------------------------
      // users/{userId}/events/{eventId} — append-only
      // -------------------------------------------------------------
      match /events/{eventId} {
        allow read: if isOwner(uid) || isInvitedCaregiver(uid);
        allow create: if isOwner(uid) && isValidEvent();
        allow update, delete: if false;
      }

      // -------------------------------------------------------------
      // users/{userId}/alerts/{alertId} — append-only
      // -------------------------------------------------------------
      match /alerts/{alertId} {
        allow read: if isOwner(uid) || isInvitedCaregiver(uid);
        allow create: if isOwner(uid) && isValidAlert();
        allow update, delete: if false;
      }

      // -------------------------------------------------------------
      // users/{userId}/incidents/{incidentId} — relapse-risk record,
      // append-only. Holds a snapshot, so it is deliberately readable ONLY by
      // the person themselves and a caregiver they explicitly linked.
      // -------------------------------------------------------------
      match /sessions/{sessionId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) &&
          hasOnlyAllowedFields(['transcript', 'createdAt']) &&
          hasRequiredFields(['transcript', 'createdAt']) &&
          request.resource.data.transcript is string &&
          request.resource.data.transcript.size() <= 6000 &&
          isRecentServerTimestamp('createdAt');
        allow update, delete: if false;
      }

      match /incidents/{incidentId} {
        allow read: if isOwner(uid) || isInvitedCaregiver(uid);
        allow create: if isOwner(uid) && isValidIncident();
        allow update, delete: if false;
      }
    }

    // ---------------------------------------------------------------
    // Default deny everything else
    // ---------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
