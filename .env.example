# Firebase web app config. Copy to .env.local and fill in using
# `firebase apps:sdkconfig WEB <app-id>`.
#
# These are NOT secrets. Firebase web config is public by design and ships in the
# client bundle — it identifies the project, it does not authorise anything. Access
# is controlled by Firestore security rules and Auth authorized-domains (and
# App Check, which should be enabled before any real launch).
#
# There is deliberately NO Gemini API key here: every model call goes through
# Firebase AI Logic, so no AI key ever reaches the client or this file.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
