# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Secrets — never commit. `*.local` already covers .env.local, but be explicit:
# a plain `.env` or a stray service-account key must never be tracked.
.env
.env.*
!.env.example
*service-account*.json
*-sa-key.json
*.pem
*.p12

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.firebase/

# Flutter / Dart / Android build artifacts (moved from mobile/.gitignore
# when the Flutter app was promoted to repo root)
**/doc/api/
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/
android/app/debug
android/app/profile
android/app/release
android/.gradle/
android/local.properties
app.*.symbols
app.*.map.json

# Claude Code background-job worktrees (ephemeral, machine-local)
.claude/worktrees/
