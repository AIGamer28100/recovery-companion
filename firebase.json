{
  "hosting": {
    "public": "node-web/dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "recovery-companion-hack",
          "appId": "1:902628596067:android:f5afdd5ddedb8b27295b56",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "recovery-companion-hack",
          "configurations": {
            "android": "1:902628596067:android:f5afdd5ddedb8b27295b56"
          }
        }
      }
    }
  }
}
